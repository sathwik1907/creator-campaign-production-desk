# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session & Security
SESSION_SECRET=your_long_random_session_secret_key_here
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Ollama AI Configuration (Single source of truth)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Account Email Delivery (required in production)
# Verify your sending domain and sender with Resend before production deployment.
RESEND_API_KEY=
EMAIL_FROM=Creator Desk <noreply@example.com>

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE_MB=50
STORAGE_PATH=./uploads

# Set TRUST_PROXY=true only when deployed behind your own trusted reverse proxy
TRUST_PROXY=false
